@page "/movies"
@inject IApiClient ApiClient
@using Shared.Models

<PageTitle>Películas - Potter Academy</PageTitle>

<div class="container-fluid py-5" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); min-height: 100vh;">
    <div class="container">
        <div class="mb-5">
            <h1 style="font-size: 2.5rem; font-weight: bold; color: #333; margin-bottom: 10px;">🎬 Películas de Harry Potter</h1>
            <p style="font-size: 1.1rem; color: #666;">Descubre todas las películas de la saga cinematográfica</p>
        </div>

        @if (movies == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-dark" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-dark">Cargando películas...</p>
            </div>
        }
        else if (movies.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                <strong>⚠️ No se encontraron películas</strong>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var movie in movies)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: none; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.3s ease, box-shadow 0.3s ease; background: white;"
                             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.3)'"
                             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.2)'">
                            
                            @if (!string.IsNullOrEmpty(movie.Poster))
                            {
                                <img src="@movie.Poster" alt="@movie.Title" class="card-img-top" style="height: 300px; object-fit: cover;">
                            }
                            else
                            {
                                <div style="height: 300px; background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem;">
                                    🎥
                                </div>
                            }
                            
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title" style="font-weight: bold; color: #333; margin-bottom: 8px;">@movie.Title</h5>
                                
                                <div style="font-size: 0.9rem; color: #666; margin-bottom: 15px;">
                                    @if (!string.IsNullOrEmpty(movie.ReleaseDate))
                                    {
                                        <p style="margin: 5px 0;"><strong>📅 Estreno:</strong> @movie.ReleaseDate</p>
                                    }
                                    @if (!string.IsNullOrEmpty(movie.Directors))
                                    {
                                        <p style="margin: 5px 0;"><strong>🎞️ Director:</strong> @movie.Directors</p>
                                    }
                                    @if (!string.IsNullOrEmpty(movie.RunningTime))
                                    {
                                        <p style="margin: 5px 0;"><strong>⏱️ Duración:</strong> @movie.RunningTime</p>
                                    }
                                </div>
                                
                                @if (!string.IsNullOrEmpty(movie.Wiki))
                                {
                                    <a href="@movie.Wiki" target="_blank" class="btn btn-sm btn-outline-warning" style="margin-top: auto;">
                                        Más información →
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<MovieDto>? movies;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            movies = await ApiClient.GetMoviesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading movies: {ex.Message}");
            movies = [];
        }
    }
}
