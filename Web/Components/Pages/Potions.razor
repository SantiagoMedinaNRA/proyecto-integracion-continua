@page "/potions"
@inject IApiClient ApiClient
@using Shared.Models

<PageTitle>Pociones - Potter Academy</PageTitle>

<div class="container-fluid py-5" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); min-height: 100vh;">
    <div class="container">
        <div class="mb-5">
            <h1 style="font-size: 2.5rem; font-weight: bold; color: #fff; margin-bottom: 10px;">🧪 Pociones Mágicas</h1>
            <p style="font-size: 1.1rem; color: rgba(255,255,255,0.9);">Descubre todas las pociones del mundo de Harry Potter</p>
        </div>

        @if (potions == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-light">Cargando pociones...</p>
            </div>
        }
        else if (potions.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                <strong>⚠️ No se encontraron pociones</strong>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var potion in potions)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: none; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.3s ease, box-shadow 0.3s ease; background: white;"
                             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.3)'"
                             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.2)'">
                            
                            @if (!string.IsNullOrEmpty(potion.Image))
                            {
                                <img src="@potion.Image" alt="@potion.Name" class="card-img-top" style="height: 250px; object-fit: cover;">
                            }
                            else
                            {
                                <div style="height: 250px; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem;">
                                    🧪
                                </div>
                            }
                            
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title" style="font-weight: bold; color: #333; margin-bottom: 8px;">@potion.Name</h5>
                                
                                @if (!string.IsNullOrEmpty(potion.Effect))
                                {
                                    <p class="card-text" style="color: #00f2fe; font-weight: 600; margin-bottom: 10px;">
                                        <small>@potion.Effect</small>
                                    </p>
                                }
                                
                                <div style="font-size: 0.9rem; color: #666; margin-bottom: 15px;">
                                    @if (!string.IsNullOrEmpty(potion.Difficulty))
                                    {
                                        <p style="margin: 5px 0;"><strong>⚠️ Dificultad:</strong> @potion.Difficulty</p>
                                    }
                                    @if (!string.IsNullOrEmpty(potion.Time))
                                    {
                                        <p style="margin: 5px 0;"><strong>⏱️ Tiempo:</strong> @potion.Time</p>
                                    }
                                </div>
                                
                                @if (!string.IsNullOrEmpty(potion.Wiki))
                                {
                                    <a href="@potion.Wiki" target="_blank" class="btn btn-sm btn-outline-info" style="margin-top: auto;">
                                        Más información →
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<PotionDto>? potions;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            potions = await ApiClient.GetPotionsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading potions: {ex.Message}");
            potions = [];
        }
    }
}
