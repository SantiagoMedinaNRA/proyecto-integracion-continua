@page "/characters"
@inject IApiClient ApiClient
@using Shared.Models

<PageTitle>Personajes - Potter Academy</PageTitle>

<div class="container-fluid py-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); min-height: 100vh;">
    <div class="container">
        <div class="mb-5">
            <h1 style="font-size: 2.5rem; font-weight: bold; color: #333; margin-bottom: 10px;">🧙 Personajes del Mundo Mágico</h1>
            <p style="font-size: 1.1rem; color: #666;">Conoce a todos los personajes de Harry Potter</p>
        </div>

        @if (characters == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-muted">Cargando personajes...</p>
            </div>
        }
        else if (characters.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                <strong>⚠️ No se encontraron personajes</strong>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var character in characters)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: none; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); transition: transform 0.3s ease, box-shadow 0.3s ease;"
                             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.15)'"
                             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.1)'">
                            
                            @if (!string.IsNullOrEmpty(character.Image))
                            {
                                <img src="@character.Image" alt="@character.Name" class="card-img-top" style="height: 250px; object-fit: cover;">
                            }
                            else
                            {
                                <div style="height: 250px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem;">
                                    🧙
                                </div>
                            }
                            
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title" style="font-weight: bold; color: #333; margin-bottom: 12px;">@character.Name</h5>
                                
                                <div style="font-size: 0.9rem; color: #666; margin-bottom: 12px; space-y: 3px;">
                                    @if (!string.IsNullOrEmpty(character.House))
                                    {
                                        <p style="margin: 5px 0;"><strong>🏰 Casa:</strong> <span style="color: #764ba2; font-weight: 500;">@character.House</span></p>
                                    }
                                    @if (!string.IsNullOrEmpty(character.Species))
                                    {
                                        <p style="margin: 5px 0;"><strong>👥 Especie:</strong> @character.Species</p>
                                    }
                                    @if (!string.IsNullOrEmpty(character.Gender))
                                    {
                                        <p style="margin: 5px 0;"><strong>⚧️ Género:</strong> @character.Gender</p>
                                    }
                                    @if (!string.IsNullOrEmpty(character.BloodStatus))
                                    {
                                        <p style="margin: 5px 0;"><strong>🩸 Linaje:</strong> @character.BloodStatus</p>
                                    }
                                </div>

                                <div style="background-color: #f8f9fa; padding: 12px; border-radius: 8px; margin-bottom: 12px; font-size: 0.85rem;">
                                    @if (!string.IsNullOrEmpty(character.Patronus))
                                    {
                                        <p style="margin: 5px 0;"><strong>✨ Patronus:</strong> @character.Patronus</p>
                                    }
                                    else
                                    {
                                        <p style="margin: 5px 0; color: #999;"><strong>✨ Patronus:</strong> No disponible</p>
                                    }
                                    @if (!string.IsNullOrEmpty(character.Wand))
                                    {
                                        <p style="margin: 5px 0;"><strong>🪄 Varita:</strong> @character.Wand</p>
                                    }
                                </div>
                                
                                @if (!string.IsNullOrEmpty(character.Wiki))
                                {
                                    <a href="@character.Wiki" target="_blank" class="btn btn-sm btn-outline-primary" style="margin-top: auto;">
                                        Más información →
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Controls -->
            <div class="d-flex justify-content-center align-items-center gap-3 mt-5">
                <button class="btn btn-outline-primary" @onclick="LoadPreviousPage" disabled="@(currentPage == 1)">
                    ← Anterior
                </button>
                <span style="font-weight: bold; font-size: 1.1rem;">
                    Página @currentPage
                </span>
                <button class="btn btn-outline-primary" @onclick="LoadNextPage">
                    Siguiente →
                </button>
            </div>
        }
    </div>
</div>

@code {
    private List<CharacterDto>? characters;
    private int currentPage = 1;
    private const int pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(currentPage);
    }

    private async Task LoadPage(int page)
    {
        try
        {
            currentPage = page;
            characters = null; // Show loading state
            characters = await ApiClient.GetCharactersAsync(currentPage, pageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading characters: {ex.Message}");
            characters = [];
        }
    }

    private async Task LoadNextPage()
    {
        await LoadPage(currentPage + 1);
    }

    private async Task LoadPreviousPage()
    {
        if (currentPage > 1)
        {
            await LoadPage(currentPage - 1);
        }
    }
}
