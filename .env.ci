# CI/CD Environment - Used by GitHub Actions
# These values are set for docker-compose validation in CI/CD pipelines
# Do NOT use these in production

COMPOSE_NETWORK=potter-network
WEB_SERVICE_NAME=potter-web
WEB_PORT=8001
ASPNETCORE_ENVIRONMENT=Production
API_SERVICE_NAME=potter-api
API_PORT=8000
API_ASPNETCORE_ENVIRONMENT=Production
VALKEY_SERVICE_NAME=potter-valkey
VALKEY_PORT=6379
POTTER_DB_BASE_URL=https://api.potterdb.com
