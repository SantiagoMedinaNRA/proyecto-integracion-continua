# API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5000;http://localhost:5000

# Potter DB API
POTTER_API_BASE_URL=https://api.potterdb.com/v1
POTTER_API_TIMEOUT_SECONDS=10

# Cache Configuration
CACHE_DEFAULT_TTL_MINUTES=60

# Logging
SERILOG_LOG_LEVEL=Information
