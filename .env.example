# Potter Academy - Environment Configuration Example
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env with sensitive values

# Web Application
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8000

# API Configuration
API_ASPNETCORE_ENVIRONMENT=Production
API_ASPNETCORE_URLS=http://+:8000
API_BASE_URL=http://api:8000

# Valkey (Redis-compatible) Configuration
VALKEY_CONNECTION=valkey:6379
POTTER_DB_BASE_URL=https://api.potterdb.com

# Compose Service Names
WEB_SERVICE_NAME=potter-web
API_SERVICE_NAME=potter-api
VALKEY_SERVICE_NAME=potter-valkey

# Network
COMPOSE_NETWORK=potter-network

# Ports
WEB_PORT=5001
API_PORT=5000
VALKEY_PORT=6379

# Logging
LOG_LEVEL=Information
